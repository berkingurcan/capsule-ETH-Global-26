# Capsule backend — copy to .env.local and fill in.
# .env*.local is gitignored. Nothing in here is safe to commit.

# --- chain -----------------------------------------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployed in build step 2. Holds root roles on the PermissionedResolver.
CAPSULE_MINTER_ADDRESS=0xe609aE1Cfb8277cE14286428Aa1D0D88A337a362

# Every capsule is a label under this name.
CAPSULE_PARENT_NAME=capsulefleet.eth

# --- secret store ----------------------------------------------------------
# Neon. Use the POOLED connection string (…-pooler.…) — this runs serverless.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# 32 bytes, base64. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Losing this makes every stored prompt and agent key unrecoverable.
SECRET_MASTER_KEY=

# --- provisioner -----------------------------------------------------------
# fly tokens create org  (or deploy token scoped to the app)
FLY_API_TOKEN=
FLY_APP_NAME=capsule-agents
FLY_REGION=ord

# Optional. Defaults to registry.fly.io/$FLY_APP_NAME:latest.
# Pin a digest here once the image is stable.
# RUNNER_IMAGE=

# --- this deployment -------------------------------------------------------
# Written into the agent-endpoint[capsule] record at mint time, so a booted
# runner calls it for its prompt and its sealed credentials. Must be reachable
# from Fly — not localhost.
CAPSULE_PUBLIC_URL=https://capsule.vercel.app

# The ENSIP-27 schema every minted name points at. Passed to CapsuleMinter's
# constructor (contracts/.env, CAPSULE_SCHEMA_URI) and served by this app at
# /schema/capsule-agent-v1.json. It must not change meaning once names carry
# it: new fields get a v2 path, never an edit to v1.
