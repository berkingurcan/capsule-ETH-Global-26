# Capsule backend — copy to .env.local and fill in.
# .env*.local is gitignored. Nothing in here is safe to commit.

# --- chain -----------------------------------------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# The parent-agnostic minter. One deployment serves every ENS name whose owner
# has connected it at /connect, so this address does NOT change when someone
# brings their own name — only when the contract itself is redeployed.
#
# Every ENSIP-25 registration key is derived from the minter address, so a name
# minted under an older minter carries a key this one will never produce.
# Superseded: 0xe609aE1C…a362 (dotted keys), 0x193Bb7dB…4819 (single-parent).
CAPSULE_MINTER_ADDRESS=

# The block CAPSULE_MINTER_ADDRESS was deployed in. The fleet dashboard scans
# CapsuleMinted logs from here; a public RPC will not scan from 0. Take it from
# contracts/broadcast/DeployCapsuleMinter.s.sol/11155111/run-latest.json.
CAPSULE_MINTER_BLOCK=11660129

# The name the launch form OPENS on and the name /fleet shows when no other is
# asked for. A default, not a limit: any name whose owner connects it at
# /connect can issue capsules, and /launch?parent= and /fleet?parent= address
# them. Must be a second-level .eth name.
CAPSULE_PARENT_NAME=capsulefleet.eth

# The same value, for the browser. The launch form renders it, and env.ts
# refuses to load client-side, so it is duplicated and asserted rather than
# imported. loadServerEnv() fails if these two disagree.
NEXT_PUBLIC_CAPSULE_PARENT_NAME=capsulefleet.eth

# --- secret store ----------------------------------------------------------
# Neon. Use the POOLED connection string (…-pooler.…) — this runs serverless.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# 32 bytes, base64. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Losing this makes every stored prompt and agent key unrecoverable.
SECRET_MASTER_KEY=

# --- provisioner -----------------------------------------------------------
# fly tokens create org  (or deploy token scoped to the app)
FLY_API_TOKEN=
FLY_APP_NAME=capsule-agents
FLY_REGION=ord

# Optional. Defaults to registry.fly.io/$FLY_APP_NAME:latest.
# Pin a digest here once the image is stable.
# RUNNER_IMAGE=

# Optional. Memory per capsule machine. The gateway, the supervisor and Codex
# measured 842 MiB together, so 1024 is the floor and the loader refuses less:
# a 512 MB machine OOMs before the bot answers and the restart looks like a
# clean boot. 2048 until Codex is pinned off. See GATE-LOG.md.
# FLY_MACHINE_MEMORY_MB=2048

# Required by POST /api/capsule/provision, and by nothing else — every other
# route and page loads without it. Pays each agent's first gas so it can write
# its own heartbeat. Fund it on Sepolia; the provisioner refuses with the
# shortfall named when it runs dry.
CAPSULE_FUNDER_KEY=

# Optional. The balance every agent is topped up TO, not the amount sent, so
# provisioning the same capsule twice costs nothing the second time. A beat is
# 47,639 gas, so 0.01 ETH is ~210 beats at 1 gwei — about ten weeks at the
# default three-a-day cadence, or three hours at the demo's sixty seconds.
# CAPSULE_AGENT_FUNDING_ETH=0.01

# Optional. Handed to every machine the provisioner creates. 28800 is three
# beats a day. Set 60 before a demo so the dashboard moves while someone is
# watching it; HEARTBEAT must be >= TICK or the runner refuses to boot.
# CAPSULE_TICK_SECONDS=30
# CAPSULE_HEARTBEAT_SECONDS=28800

# --- this deployment -------------------------------------------------------
# Written into the agent.endpoint record at mint time, so a booted runner
# calls it for its prompt. Must be reachable from Fly — not localhost.
CAPSULE_PUBLIC_URL=https://REPLACE-ME.vercel.app

# --- the subgraph ----------------------------------------------------------
# The Studio query URL for the fleet subgraph, API key included. When set,
# /fleet is read from the index instead of scanned off eth_getLogs — one query
# instead of six round trips, and `writer`, beat intervals and
# `secondsSinceLastBeat` come back as fields rather than as a join done in the
# page. Unset, or failing, and the chain reader in lib/capsule/fleet.ts runs
# instead; the dashboard prints which one served it either way.
#
#   https://api.studio.thegraph.com/query/<account>/<subgraph>/<version>
#
# See subgraph/README.md for deploying it.
# SUBGRAPH_URL=

# --- the analyst -----------------------------------------------------------
# Required by /api/analyst, and by nothing else. All three, or the route
# answers 503 naming the one that is missing; every other page loads without
# them.
#
# The analyst reaches the same subgraph through The Graph's hosted Subgraph MCP
# server, which addresses subgraphs by id and authenticates with a gateway key —
# a different door from SUBGRAPH_URL above, hence a different credential.
# ANTHROPIC_API_KEY=
# GRAPH_API_KEY=

# The subgraph's id in Subgraph Studio — the base58 string, NOT the query URL.
# This is what pins the analyst to the fleet rather than to whichever subgraph a
# keyword search happened to surface.
# SUBGRAPH_ID=
