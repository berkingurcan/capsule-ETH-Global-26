{
  "name": "capsule-client",
  "version": "0.1.2",
  "private": true,
  "description": "Capsule launchpad + fleet dashboard \u2014 front end only, mock data",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "preflight": "node --env-file=.env.local --import tsx scripts/preflight.ts",
    "check:wire": "node --import tsx scripts/check-wire.ts",
    "check:records": "node --import tsx scripts/check-records.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "check:store": "node --env-file=.env.local --import tsx scripts/store-check.ts",
    "seed:dev": "node --env-file=.env.local --import tsx scripts/seed-dev.ts",
    "check:route": "node --env-file=../runner/.env --env-file=.env.local --import tsx scripts/route-check.ts",
    "check:fleet": "node --env-file=.env.local --import tsx scripts/check-fleet.ts",
    "check:prepare": "node --env-file=.env.local --import tsx scripts/check-prepare.ts",
    "check:mint": "node --env-file=.env.local --import tsx scripts/check-mint.ts",
    "check:recall": "node --env-file=.env.local --import tsx scripts/check-recall.ts",
    "check:provision": "node --env-file=.env.local --import tsx scripts/check-provision.ts",
    "check:register": "node --env-file=.env.local --import tsx scripts/check-register.ts",
    "fork:register": "node --import tsx scripts/fork-register.ts",
    "fork:subregistry": "node --import tsx scripts/fork-subregistry.ts",
    "fix:endpoint": "node --env-file=.env.local --import tsx scripts/fix-endpoint.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "next": "^15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "tsx": "^4.23.13",
    "typescript": "5.7.2"
  }
}